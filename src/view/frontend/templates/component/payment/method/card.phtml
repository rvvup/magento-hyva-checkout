    step, for example after the shopper changes their address, shipping method or coupon. */ ?>
    <div id="rvvup-card-form" wire:ignore>
        <div id="rvvup-card-form-container" class="rvvup-card-form"></div>
    </div>
<?php endif; ?>
<?php if ($magewire->showFrame()): ?>
    <div wire:ignore>
        <iframe class="rvvup-summary w-full"
                allowtransparency="true"
                src="<?= $escaper->escapeHtmlAttr($magewire->getIframeUrl()); ?>"></iframe>
    </div>
<?php endif; ?>
