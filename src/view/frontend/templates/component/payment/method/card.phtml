<?php
/** @var Rvvup\PaymentsHyvaCheckout\Magewire\Checkout\Payment\Method\Card $magewire */
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<?php if ($magewire->showForm()): ?>
    <?php /* wire:ignore keeps the mounted SDK iframes alive when Magewire re-renders the payment
    step, for example after the shopper changes their address, shipping method or coupon. */ ?>
    <div id="rvvup-card-form" wire:ignore>
        <div id="rvvup-card-form-container" class="rvvup-card-form"></div>
        <?php if ($magewire->showSaveCard()): ?>
            <label class="flex items-center gap-2 mt-4 cursor-pointer" for="rvvup-save-card">
                <input type="checkbox" id="rvvup-save-card" class="form-checkbox">
                <span><?= $escaper->escapeHtml(__('Save this card for future purchases')) ?></span>
            </label>
        <?php endif; ?>
    </div>
<?php endif; ?>
<?php if ($magewire->showFrame()): ?>
    <div wire:ignore>
        <iframe class="rvvup-summary w-full"
                allowtransparency="true"
                src="<?= $escaper->escapeHtmlAttr($magewire->getIframeUrl()); ?>"></iframe>
    </div>
<?php endif; ?>
