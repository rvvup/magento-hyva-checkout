<?php
/**
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 * @var Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */
/** Magento 2.3.5 backward compatibility fix */
if (!isset($escaper)) {
    $escaper = $block;
}

$product = $block->getProduct();
if ($product === null) {
    return;
}

/** @var \Rvvup\PaymentsHyvaCheckout\ViewModel\ProductAmount $productAmount */
$productAmount = $viewModels->require(\Rvvup\PaymentsHyvaCheckout\ViewModel\ProductAmount::class);
$initialPrice = $productAmount->getAmount($product);
$wrapperId = 'rvvup-zrf-widget-wrapper-' . (int) $product->getId();
$currencyCode = $block->getProduct()->getStore()->getCurrentCurrencyCode();
$isRestricted = (bool) $product->getRvvupRestricted();
if ($isRestricted) {
    return;
}
?>
<div id="<?= $escaper->escapeHtmlAttr($wrapperId) ?>"
     data-currency="<?= $escaper->escapeHtmlAttr($currencyCode) ?>"
     data-amount="<?= $escaper->escapeHtmlAttr($initialPrice) ?>"
     data-product-id="<?= $escaper->escapeHtmlAttr($product->getId()) ?>">
    <div id="rvvup-zrf-widget-container"></div>
    <script>
        (function () {
            const container = document.getElementById('<?= $escaper->escapeJs($wrapperId) ?>');
            if (!container) {
                return;
            }
            const currency = container.dataset.currency;
            const productId = container.dataset.productId;
            const createdAmount = container.dataset.amount;

            let latestAmount = createdAmount;
            let readyWidget = null;

            const showHideWidget = async function (widget) {
                const el = document.getElementById("rvvup-zrf-widget-container");
                if (!el) {
                    return;
                }
                el.style.display = (await widget.canDisplayWidget()) ? "block" : "none";
            };

            // Register the price listener synchronously so a swatch change made before
            // the widget finishes loading is not lost (Clearpay and PayPal do the same).
            const applyAmount = async (amount) => {
                if (amount === undefined || amount === null || isNaN(Number(amount))) {
                    return;
                }
                latestAmount = Number(amount).toFixed(2);
                if (readyWidget === null) {
                    return;
                }
                readyWidget.update({total: {amount: latestAmount, currency: currency}});
                await showHideWidget(readyWidget);
            };

            window.addEventListener('update-prices-' + productId, (e) => {
                applyAmount(e.detail?.finalPrice?.amount);
            });
            // Hyva bundle products do not fire update-prices-<id>. They fire
            // update-product-final-price (detail: number) and update-bundle-option-prices
            // (detail: {oldPrice: number, finalPrice: number}).
            const amountFrom = (d) => (d !== null && typeof d === 'object') ? (d.finalPrice?.amount ?? d.finalPrice ?? d.amount ?? d.price) : d;
            window.addEventListener('update-product-final-price', (e) => applyAmount(amountFrom(e.detail)));
            window.addEventListener('update-bundle-option-prices', (e) => applyAmount(amountFrom(e.detail)));

            if (!window.rvvup_sdk) {
                return;
            }

            window.rvvup_sdk.createWidget("ZOPA_RETAIL_FINANCE", {
                settings: {
                    context: "product",
                },
                total: {
                    currency: currency,
                    amount: createdAmount,
                },
            }).then((widget) => {
                widget.on("ready", async () => {
                    const el = document.getElementById("rvvup-zrf-widget-container");
                    if (!el) {
                        return;
                    }
                    try {
                        await widget.mount({selector: el});
                        readyWidget = widget;
                        if (latestAmount !== createdAmount) {
                            widget.update({total: {amount: latestAmount, currency: currency}});
                        }
                        await showHideWidget(widget);
                    } catch (error) {
                        el.style.display = "none";
                        console.error("Error mounting Rvvup widget:", error);
                    }
                });
            }).catch((error) => {
                console.error("Error creating Rvvup widget:", error);
            });
        })();
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
</div>
